---
// Ilustración inspirada (no copiada) en la portada de The Stage de Avenged Sevenfold:
// un punto azul pálido en el centro, niebla verde y rayos que se abren como alas.
// Los rayos se generan con desplazamiento de punto medio y semilla fija (salida estable).
let seed = 7;
const rand = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };

type P = [number, number];
function bolt(a: P, b: P, depth: number, spread: number): P[] {
  if (depth === 0) return [a, b];
  const m: P = [(a[0] + b[0]) / 2 + (rand() - 0.5) * spread, (a[1] + b[1]) / 2 + (rand() - 0.5) * spread];
  return [...bolt(a, m, depth - 1, spread / 2), ...bolt(m, b, depth - 1, spread / 2).slice(1)];
}
const path = (pts: P[]) => 'M' + pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(' L');

const C: P = [200, 110];
const bolts: { d: string; w: number; delay: number }[] = [];
for (const side of [-1, 1]) {
  for (let k = 0; k < 3; k++) {
    const end: P = [C[0] + side * (130 + rand() * 60), C[1] + (k - 1) * 55 + (rand() - 0.5) * 30];
    const start: P = [C[0] + side * 14, C[1] + (rand() - 0.5) * 8];
    const main = bolt(start, end, 5, 46);
    bolts.push({ d: path(main), w: 1.6 - k * 0.3, delay: rand() * 6 });
    // rama secundaria desde un punto intermedio
    const from = main[Math.floor(main.length * (0.35 + rand() * 0.3))]!;
    const to: P = [from[0] + side * (40 + rand() * 40), from[1] + (rand() - 0.5) * 70];
    bolts.push({ d: path(bolt(from, to, 4, 26)), w: 0.7, delay: rand() * 6 });
  }
}
---
<svg class="stage" viewBox="0 0 400 220" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  <defs>
    <filter id="fog" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="4" seed="16" />
      <feColorMatrix values="0 0 0 0 0.12  0 0 0 0 0.55  0 0 0 0 0.36  0 0 0 1.1 -0.35" />
      <feGaussianBlur stdDeviation="2" />
    </filter>
    <radialGradient id="fogMask">
      <stop offset="0" stop-color="#fff" stop-opacity="0.95" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <mask id="fogFade"><ellipse cx="200" cy="110" rx="190" ry="105" fill="url(#fogMask)" /></mask>
    <radialGradient id="dot">
      <stop offset="0" stop-color="#e6f3ff" />
      <stop offset="0.35" stop-color="#8fc8ff" />
      <stop offset="1" stop-color="#8fc8ff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="400" height="220" fill="#020406" />
  <rect width="400" height="220" filter="url(#fog)" mask="url(#fogFade)" />
  <g class="bolts">
    {bolts.map((b) => <path d={b.d} stroke-width={b.w} style={`animation-delay:${b.delay.toFixed(2)}s`} />)}
  </g>
  <circle cx="200" cy="110" r="16" fill="url(#dot)" />
  <circle cx="200" cy="110" r="2.2" fill="#eaf6ff" />
</svg>

<style>
  .stage { display: block; width: 100%; height: 100%; }
  .bolts path {
    fill: none; stroke: #d8f4ff; stroke-linecap: round; stroke-linejoin: round;
    filter: drop-shadow(0 0 3px #7fd3ff); opacity: 0.55;
    animation: flicker 7s infinite;
  }
  @keyframes flicker {
    0%, 86%, 100% { opacity: 0.45; }
    88% { opacity: 1; }
    90% { opacity: 0.3; }
    92% { opacity: 0.95; }
  }
</style>
