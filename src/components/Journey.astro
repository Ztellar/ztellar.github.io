---
import type { Dict } from '../i18n';
interface Props { dict: Dict }
const { dict } = Astro.props;
---
<section id="journey">
  <h2 data-obj="VOYAGER 2 · GRAND TOUR">{dict.journey.heading}</h2>
  <p>{dict.journey.intro}</p>
  <ol class="track">
    {dict.journey.items.map((m) => (
      <li class={`reveal ${m.kind}`}>
        <span class="node" aria-hidden="true"></span>
        <p class="year mono">{m.year}</p>
        <h3>{m.title}</h3>
        <p class="text">{m.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .track {
    list-style: none; margin: 2rem 0 0; padding: 0 0 1rem;
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(12.5rem, 1fr);
    gap: 1.2rem; overflow-x: auto; scroll-snap-type: x mandatory;
    position: relative;
    scrollbar-color: var(--line) transparent;
  }
  .track li {
    position: relative; padding-top: 1.8rem; scroll-snap-align: start;
    --c: var(--accent-2);
  }
  /* Línea de órbita que une los hitos */
  .track li::before {
    content: ''; position: absolute; top: 0.45rem; left: 0; right: -1.2rem;
    height: 1px; background: linear-gradient(90deg, var(--c), var(--line));
  }
  .track li:last-child::before { right: 0; }
  .node {
    position: absolute; top: 0.1rem; left: 0; width: 0.75rem; height: 0.75rem; border-radius: 50%;
    background: var(--c); box-shadow: 0 0 10px var(--c);
  }
  .edu { --c: #b9c4ff; }
  .teach { --c: #5dff9a; }
  .work { --c: var(--accent-2); }
  .build { --c: #ff6fcf; }
  .space { --c: var(--accent); }
  .space .node { width: 1rem; height: 1rem; top: -0.03rem; box-shadow: 0 0 18px var(--c); }
  .year { color: var(--c); margin-bottom: 0.3rem; }
  h3 { font-size: 1rem; margin-bottom: 0.4rem; }
  .text { font-size: 0.88rem; color: var(--ink-dim); }
  @media (max-width: 720px) {
    .track { grid-auto-flow: row; grid-auto-columns: auto; overflow: visible; padding-left: 1.6rem; gap: 1.4rem; }
    .track li { padding-top: 0; }
    .track li::before { top: 0.9rem; bottom: -1.4rem; left: -1.25rem; right: auto; width: 1px; height: auto; background: var(--line); }
    .track li:last-child::before { display: none; }
    .node, .space .node { left: -1.6rem; top: 0.3rem; }
  }
</style>
