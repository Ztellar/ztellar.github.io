---
import BlackHole from './BlackHole.astro';
import type { Dict } from '../i18n';
interface Props { dict: Dict }
const { dict } = Astro.props;
---
<section id="hero">
  <BlackHole />
  <div class="inner">
    <div class="text">
      <p class="mono kicker">
        {dict.hero.kicker}
        <span class="clock" hidden>· {dict.hero.localTime} <time data-clock data-lang={dict.lang}></time></span>
      </p>
      <h1>{dict.hero.name}</h1>
      <p class="title">{dict.hero.title}</p>
      <p class="tagline">{dict.hero.tagline}</p>
      <p class="now mono"><span class="pulse" aria-hidden="true"></span>{dict.hero.now}</p>
      <div class="ctas">
        <a class="btn primary" href="#projects">{dict.hero.ctaProjects}</a>
        <a class="btn" href="#contact">{dict.hero.ctaContact}</a>
      </div>
      <dl class="stats">
        {dict.hero.stats.map((s) => (
          <div>
            <dt class="mono">{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
  <p class="caption mono" aria-hidden="true">Sgr A* · 17h 45m 40s · −29° 00′ 28″</p>
</section>

<script>
  // Reloj en hora de Chile continental (sigue el horario de verano automáticamente).
  const el = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat(el.dataset.lang === 'en' ? 'en-GB' : 'es-CL', {
      hour: '2-digit', minute: '2-digit', timeZone: 'America/Santiago',
    });
    const tick = () => { el.textContent = fmt.format(new Date()); };
    tick();
    el.closest<HTMLElement>('.clock')!.hidden = false;
    setInterval(tick, 30_000);
  }
</script>

<style>
  section {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: calc(100svh - 3.5rem);
    display: flex;
    align-items: center;
    border-top: none;
    padding: 2rem 0;
  }
  .inner { width: 100%; max-width: 60rem; margin: 0 auto; padding: 0 1.5rem; position: relative; z-index: 1; }
  .text { max-width: 31rem; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); text-shadow: 0 2px 24px rgba(0, 0, 0, 0.85); }
  .title { color: var(--ink); font-size: 1.15rem; margin-bottom: 0.6rem; }
  .tagline { color: var(--ink-dim); text-shadow: 0 1px 12px rgba(0, 0, 0, 0.9); }
  .now { color: var(--accent); display: inline-flex; align-items: center; gap: 0.6rem; }
  .pulse {
    width: 0.55rem; height: 0.55rem; border-radius: 50%; flex: none;
    background: #5dff9a; box-shadow: 0 0 0 0 rgba(93, 255, 154, 0.6);
    animation: pulse 2.2s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(93, 255, 154, 0.55); }
    70% { box-shadow: 0 0 0 9px rgba(93, 255, 154, 0); }
    100% { box-shadow: 0 0 0 0 rgba(93, 255, 154, 0); }
  }
  .ctas { display: flex; gap: 0.8rem; margin-top: 0.8rem; flex-wrap: wrap; }
  .stats {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem; margin: 2.2rem 0 0; padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .stats > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.2rem; }
  .stats dt { font-size: 0.72rem; line-height: 1.35; }
  .stats dd { margin: 0; font-family: var(--mono); font-size: 1.45rem; color: var(--ink); text-shadow: 0 0 18px rgba(255, 158, 79, 0.35); }
  .caption {
    position: absolute; right: 1.5rem; bottom: 1.2rem; z-index: 1;
    font-size: 0.72rem; letter-spacing: 0.12em; opacity: 0.75;
  }
  @media (max-width: 720px) {
    section { align-items: flex-end; }
    .inner { padding-bottom: 4.5rem; }
    .text { max-width: 100%; text-align: center; margin: 0 auto; }
    .now { display: block; }
    .pulse { display: inline-block; margin-right: 0.5rem; vertical-align: 0.05rem; }
    .ctas { justify-content: center; }
    .stats { text-align: left; }
  }
</style>
