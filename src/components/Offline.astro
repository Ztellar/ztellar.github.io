---
import StageArt from './StageArt.astro';
import type { Dict } from '../i18n';
interface Props { dict: Dict }
const { dict } = Astro.props;
const o = dict.offline;
---
<section id="offline">
  <h2>{o.heading}</h2>
  <p>{o.intro}</p>
  <div class="grid">
    <article class="card music reveal">
      <div class="art"><StageArt /></div>
      <div class="body">
        <h3 class="mono">{o.music.heading}</h3>
        <p>{o.music.text}</p>
        <p class="fav"><span class="mono">{o.music.favoriteLabel}</span><strong>{o.music.favorite}</strong></p>
        {o.music.groups.map((g) => (
          <div class="group">
            <p class="mono label">{g.label}</p>
            <p class="bands">{g.items.join(' · ')}</p>
          </div>
        ))}
      </div>
    </article>
    <article class="card reveal">
      <h3 class="mono">{o.bass.heading}</h3>
      <p>{o.bass.text}</p>
    </article>
    <article class="card reveal">
      <h3 class="mono">{o.ygo.heading}</h3>
      <p class="deck">{o.ygo.deck}</p>
      <p>{o.ygo.text}</p>
    </article>
    <article class="card reveal">
      <h3 class="mono">{o.travel.heading}</h3>
      <p>{o.travel.text}</p>
    </article>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; margin-top: 1.5rem; }
  h3 { color: var(--accent-2); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .card p { color: var(--ink-dim); font-size: 0.95rem; }
  .card p:last-child { margin-bottom: 0; }
  .music { grid-column: 1 / -1; padding: 0; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
  .art { min-height: 16rem; }
  .body { padding: 1.5rem; }
  .fav { display: flex; flex-direction: column; margin: 1rem 0; }
  .fav strong { font-family: var(--mono); font-size: 1.5rem; color: var(--ink); letter-spacing: -0.01em; }
  .group { margin-bottom: 0.6rem; }
  .label { margin: 0; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .bands { margin: 0.1rem 0 0; color: var(--ink) !important; }
  .deck { font-family: var(--mono); font-size: 1.3rem; color: var(--accent) !important; margin-bottom: 0.4rem; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; }
    .music { grid-template-columns: 1fr; }
    .art { min-height: 11rem; height: 11rem; }
  }
</style>
