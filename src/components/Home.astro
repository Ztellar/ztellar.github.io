---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Story from './Story.astro';
import Work from './Work.astro';
import Offline from './Offline.astro';
import Contact from './Contact.astro';
import type { Dict } from '../i18n';
interface Props { dict: Dict }
const { dict } = Astro.props;
---
<Base dict={dict}>
  <Hero dict={dict} />
  <Story dict={dict} />
  <Work dict={dict} />
  <Offline dict={dict} />
  <Contact dict={dict} />
</Base>
