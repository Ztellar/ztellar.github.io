---
import type { Dict } from '../i18n';
interface Props { dict: Dict }
const { dict } = Astro.props;
const c = dict.console;
const quick = c.commands.map((x) => x.cmd).filter((x) => x !== 'help' && !x.startsWith('sudo'));
---
<section id="console">
  <h2 data-obj="ALMA · 66 ANTENNAS">{c.heading}</h2>
  <p>{c.intro}</p>
  <div class="term card" data-console data-notfound={c.notFound}>
    <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span class="mono">guest@ztellar: ~</span></div>
    <div class="log mono" role="log" aria-live="polite" data-log></div>
    <form class="line mono" data-form>
      <label for="console-input" class="prompt">guest@ztellar:~$</label>
      <input id="console-input" data-input autocomplete="off" autocapitalize="off" spellcheck="false" placeholder={c.placeholder} />
    </form>
  </div>
  <p class="mono hint">{c.hint}</p>
  <div class="quick">
    {quick.map((q) => <button type="button" class="chip" data-cmd={q}>{q}</button>)}
  </div>
  <script type="application/json" data-commands set:html={JSON.stringify(c.commands)} />
</section>

<script>
  type Cmd = { cmd: string; output: string[] };
  const root = document.querySelector<HTMLElement>('[data-console]');
  const data = document.querySelector<HTMLScriptElement>('[data-commands]');
  if (root && data) {
    const commands: Cmd[] = JSON.parse(data.textContent || '[]');
    const log = root.querySelector<HTMLElement>('[data-log]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const notFound = root.dataset.notfound || '';
    const history: string[] = [];
    let hIdx = 0;

    const print = (text: string, cls?: string) => {
      const p = document.createElement('p');
      p.textContent = text;
      if (cls) p.className = cls;
      log.appendChild(p);
    };

    const run = (raw: string) => {
      const q = raw.trim().toLowerCase().replace(/\s+/g, ' ');
      if (!q) return;
      history.push(q);
      hIdx = history.length;
      if (q === 'clear') { log.textContent = ''; return; }
      print(`$ ${q}`, 'echo');
      const found = commands.find((c) => c.cmd === q);
      (found ? found.output : [notFound]).forEach((l) => print(l, found ? '' : 'err'));
      log.scrollTop = log.scrollHeight;
    };

    run('help');
    form.addEventListener('submit', (e) => { e.preventDefault(); run(input.value); input.value = ''; });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp' && hIdx > 0) { input.value = history[--hIdx]; e.preventDefault(); }
      if (e.key === 'ArrowDown') { hIdx = Math.min(history.length, hIdx + 1); input.value = history[hIdx] ?? ''; }
    });
    root.addEventListener('click', () => { if (!window.getSelection()?.toString()) input.focus({ preventScroll: true }); });
    document.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((b) =>
      b.addEventListener('click', () => run(b.dataset.cmd!)),
    );
  }
</script>

<style>
  .term { padding: 0; overflow: hidden; background: rgba(4, 7, 16, 0.88); }
  .bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.6rem 0.9rem; border-bottom: 1px solid var(--line); }
  .bar i { width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--line); }
  .bar i:first-child { background: #ff5f57; }
  .bar i:nth-child(2) { background: #febc2e; }
  .bar i:nth-child(3) { background: #28c840; }
  .bar span { margin-left: 0.6rem; font-size: 0.75rem; }
  .log { height: 15rem; overflow-y: auto; padding: 0.9rem 1rem 0; color: var(--ink); font-size: 0.85rem; }
  .log :global(p) { margin: 0 0 0.15rem; white-space: pre-wrap; max-width: none; }
  .log :global(.echo) { color: var(--accent-2); margin-top: 0.6rem; }
  .log :global(.err) { color: #ff8a80; }
  .line { display: flex; gap: 0.6rem; padding: 0.6rem 1rem 0.9rem; align-items: center; }
  .prompt { color: #5dff9a; white-space: nowrap; font-size: 0.85rem; }
  input {
    flex: 1; min-width: 0; background: transparent; border: none; outline: none;
    color: var(--ink); font: inherit; font-size: 0.85rem; caret-color: var(--accent);
  }
  @media (max-width: 720px) { input { font-size: 16px; } }
  .hint { margin-top: 1.2rem; }
  .quick button { background: transparent; cursor: pointer; }
  .quick button:hover { border-color: var(--accent-2); }
</style>
