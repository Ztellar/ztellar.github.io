---
import ConstellationGlyph from './ConstellationGlyph.astro';
import type { Dict } from '../i18n';
interface Props { dict: Dict }
const { dict } = Astro.props;
const base = dict.lang === 'en' ? '/en/' : '/';
---
<header>
  <nav aria-label="principal">
    <a class="brand mono" href={base}>~/ztellar</a>
    <div class="links">
      <a href={`${base}#story`}><ConstellationGlyph k="osiris" class="icon" />{dict.nav.story}</a>
      <a href={`${base}#work`}><ConstellationGlyph k="isis" class="icon" />{dict.nav.work}</a>
      <a href={`${base}#offline`}><ConstellationGlyph k="set" class="icon" />{dict.nav.offline}</a>
      <a href={`${base}#contact`}><ConstellationGlyph k="cassiopeia" class="icon" />{dict.nav.contact}</a>
      <a href="/cv/benjamin-salamanca-cv.pdf" download>{dict.nav.cv}</a>
      <a class="lang mono" href={dict.langSwitch.otherPath} aria-label={dict.langSwitch.ariaLabel}>{dict.langSwitch.otherLabel}</a>
    </div>
  </nav>
</header>
<!-- Cuando la barra está oculta (las constelaciones hacen de menú), CV e idioma quedan en la esquina -->
<div class="corner">
  <a class="mono" href="/cv/benjamin-salamanca-cv.pdf" download>{dict.nav.cv}</a>
  <a class="lang mono" href={dict.langSwitch.otherPath} aria-label={dict.langSwitch.ariaLabel}>{dict.langSwitch.otherLabel}</a>
</div>

<style>
  /* La barra solo aparece donde no hay mapa de constelaciones: sky.ts pone `nav-on` en <html>
     (móvil siempre; escritorio angosto al dejar el hero). Sin JS, siempre visible. */
  header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 10;
    transition: transform 0.35s ease, opacity 0.35s ease;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  nav {
    max-width: 60rem; margin: 0 auto; padding: 0.8rem 1.5rem;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  }
  :global(.js:not(.nav-on)) header { transform: translateY(-100%); opacity: 0; pointer-events: none; }
  .corner {
    position: fixed; top: 1rem; right: 1.25rem; z-index: 10;
    display: flex; gap: 0.6rem; align-items: center;
    transition: opacity 0.35s ease;
  }
  .corner a { color: var(--ink-dim); text-decoration: none; font-size: 0.8rem; }
  .corner a:hover { color: var(--ink); }
  :global(html:not(.js)) .corner, :global(.nav-on) .corner { opacity: 0; pointer-events: none; }
  .brand { color: var(--accent); text-decoration: none; }
  .links { display: flex; gap: 1.1rem; flex-wrap: wrap; }
  .links a { color: var(--ink-dim); text-decoration: none; font-size: 0.95rem; }
  .links a:hover { color: var(--ink); }
  @media (max-width: 720px) {
    nav { padding: 0.6rem 1rem; }
    .links {
      flex-wrap: nowrap; overflow-x: auto; min-width: 0; scrollbar-width: none; gap: 0.9rem;
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }
    .links::-webkit-scrollbar { display: none; }
    .links a { white-space: nowrap; font-size: 0.88rem; }
  }
  .links a { display: inline-flex; align-items: center; gap: 0.3rem; }
  .links :global(.icon) { display: none; width: 1.1rem; height: 1.1rem; overflow: visible; }
  .links :global(.icon line) { stroke: rgba(217, 192, 138, 0.7); stroke-width: 0.03; }
  .links :global(.icon .star) { fill: #f3ead6; }
  .links :global(.icon .halo) { fill: none; stroke: rgba(207, 227, 255, 0.6); stroke-width: 0.03; }
  @media (max-width: 719px) { .links :global(.icon) { display: inline-block; } }
  .lang { border: 1px solid var(--line); border-radius: 6px; padding: 0.1rem 0.5rem; color: var(--accent-2); }
</style>
