---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import type { Dict } from '../i18n';
interface Props { dict: Dict }
const { dict } = Astro.props;
---
<!doctype html>
<html lang={dict.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={dict.meta.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#000000" />
    <title>{dict.meta.title}</title>
    <meta property="og:title" content={dict.meta.title} />
    <meta property="og:description" content={dict.meta.description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" hreflang="es" href="https://ztellar.github.io/" />
    <link rel="alternate" hreflang="en" href="https://ztellar.github.io/en/" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <canvas id="starfield" aria-hidden="true"></canvas>
    <canvas id="blackhole" aria-hidden="true"></canvas>
    <Nav dict={dict} />
    <main><slot /></main>
    <script src="../scripts/sky.ts"></script>
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
